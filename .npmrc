# pnpm settings for this standalone plugin repo.
# The @deepseek-ai/dsh-* peerDependencies are private (unreleased) packages that
# resolve at runtime from the Harness installation, not from the npm registry.
# auto-install-peers=false keeps pnpm from fetching them, and lets the
# prepare build of a git-hosted install succeed without those registry 404s.
auto-install-peers=false
